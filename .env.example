# Meta WhatsApp Business API
META_GRAPH_VERSION=v23.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=hamza-shouq-webhook
META_SEND_MODE=text
META_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=en_US

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
